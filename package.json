{
  "name": "draft-xi-league",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draft XI League: draft a starting XI from 20 real clubs and simulate a 38-matchday season.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,blue \"npm run dev -w @draft-xi/server\" \"npm run dev -w @draft-xi/web\"",
    "build": "npm run build -w @draft-xi/web",
    "start": "NODE_ENV=production npm run start -w @draft-xi/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "seed": "tsx scripts/seed.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "sim": "tsx scripts/sim.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "npm run db:generate -w @draft-xi/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
