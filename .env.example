# Database connection.
# SQLite (default): a file path, optionally prefixed with "file:". Relative paths resolve from the repo root.
# Postgres: postgres://user:password@host:5432/dbname
DATABASE_URL=file:var/draft-xi.db

# Server
# HOST=127.0.0.1
# PORT=3000
# NODE_ENV=development

# Whoever registers with this username becomes an admin.
# ADMIN_USERNAME=

# Send cookies only over HTTPS (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=false

# Seconds between the host pressing Start and the draft opening.
# START_COUNTDOWN_SECONDS=5

# Built web app the server serves in production (defaults to apps/web/dist).
# WEB_DIST=

# Development only: where the Vite dev server proxies /api and /socket.io.
# VITE_API_TARGET=http://127.0.0.1:3000
